pipeline {
    agent any 

    parameters {
        // --- PARÁMETRO PRINCIPAL DE BORRADO ---
        string(name: 'DB_NAME_TO_DELETE', defaultValue: '', description: 'Nombre exacto de la base a borrar')
        string(name: 'VERSION', description: 'Versión Destino (v15/v19)')
        string(name: 'ODOO_ID', defaultValue: '0', description: 'ID del registro enviado por Odoo') 
        
        // --- PARÁMETROS DINÁMICOS DE RETORNO ---
        string(name: 'ODOO_CB_URL', defaultValue: '', description: 'URL de retorno a Odoo')
        string(name: 'ODOO_CB_DB', defaultValue: '', description: 'BD de retorno')
        string(name: 'ODOO_CB_UID', defaultValue: '2', description: 'UID de retorno')
        password(name: 'ODOO_CB_TOKEN', defaultValue: '', description: 'Token de retorno API')
    }

    environment {
        // --- CREDENCIALES ---
        SSH_KEY_ID = 'jenkins-ssh-key' 
        // --- CONFIG ---
        IP_TEST_V15 = "148.113.165.227" 
        IP_TEST_V19 = "158.69.210.128"
    }

    stages {
        stage('1. Preparar Entorno') {
            steps {
                script {
                    cleanWs()
                    checkout scm 
                    sh "chmod +x scripts/*.sh || true"
                }
            }
        }

        stage('2. Borrar Base de Datos') {
            steps {
                script {
                    if (!params.DB_NAME_TO_DELETE) {
                        error("No se proporcionó el nombre de la base de datos (DB_NAME_TO_DELETE).")
                    }

                    // 1. Determinar a qué servidor conectarnos
                    env.TARGET_IP = (params.VERSION == 'v15') ? env.IP_TEST_V15 : env.IP_TEST_V19
                    echo "--- Iniciando borrado de ${params.DB_NAME_TO_DELETE} en ${env.TARGET_IP} ---"

                    // 2. Ejecutar borrado vía SSH
                    withCredentials([
                        sshUserPrivateKey(credentialsId: 'jenkins-ssh-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')
                    ]) {
                        sh '''
                            set -e
                            chmod 600 "$SSH_KEY"
                            
                            # Copiamos el script de borrado al servidor destino
                            scp -4 -i "$SSH_KEY" -o StrictHostKeyChecking=no scripts/delete_db.sh "ubuntu@$TARGET_IP:/tmp/"
                            
                            # Nos conectamos y ejecutamos el script pasándole el nombre de la BD
                            ssh -4 -i "$SSH_KEY" -o StrictHostKeyChecking=no "ubuntu@$TARGET_IP" \
                                "chmod +x /tmp/delete_db.sh && /tmp/delete_db.sh '${DB_NAME_TO_DELETE}'"
                        '''
                    }
                }
            }
        }
    } 
    
    post {     
        success {
            script {
                echo "Pipeline Exitoso. Ejecutando notificación a Odoo Dinámico..."
                
                def r_id = params.ODOO_ID ?: "0"
                def url  = "N/A"
                def msg  = "Eliminación Exitosa.\\nBase: ${params.DB_NAME_TO_DELETE}"
                
                withEnv([
                    "ODOO_URL=${params.ODOO_CB_URL}",
                    "ODOO_DB=${params.ODOO_CB_DB}",
                    "ODOO_UID=${params.ODOO_CB_UID}",
                    "ODOO_PASS=${params.ODOO_CB_TOKEN}"
                ]) {
                    sh "chmod +x scripts/notify_odoo.sh"
                    sh "./scripts/notify_odoo.sh '${r_id}' 'expired' '${url}' '${msg}'"
                }
            }
        }
        
        failure {
            script {
                echo "Pipeline Fallido. Reportando error a Odoo Dinámico..."
                
                def r_id = params.ODOO_ID ?: "0"
                def msg  = "Fallo en Jenkins al borrar. Ver logs: ${env.BUILD_URL}"

                withEnv([
                    "ODOO_URL=${params.ODOO_CB_URL}",
                    "ODOO_DB=${params.ODOO_CB_DB}",
                    "ODOO_UID=${params.ODOO_CB_UID}",
                    "ODOO_PASS=${params.ODOO_CB_TOKEN}"
                ]) {
                     sh "chmod +x scripts/notify_odoo.sh"
                     sh "./scripts/notify_odoo.sh '${r_id}' 'error' 'N/A' '${msg}'"
                }
            }
        }
        cleanup {
            script {
                echo "--- 🧹 Limpieza Final ---"
                cleanWs() 
            }
        }
    } 
}
